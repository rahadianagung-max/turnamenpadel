{
  "version": 2,
  "redirects": [
    { "source": "/calculator", "destination": "/simulasi", "permanent": false },
    { "source": "/calculator.html", "destination": "/simulasi", "permanent": false },
    { "source": "/contact", "destination": "/simulasi", "permanent": false },
    { "source": "/contact.html", "destination": "/simulasi", "permanent": false },
    { "source": "/demo", "destination": "/simulasi", "permanent": false },
    { "source": "/demo.html", "destination": "/simulasi", "permanent": false }
  ],
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/sheet.js" },
    { "source": "/score", "destination": "/score.html" },
    { "source": "/scorerdesk", "destination": "/court-admin.html" },
    { "source": "/courts", "destination": "/court-admin.html" },
    { "source": "/court:n(\\d+)", "destination": "/court.html" },
    { "source": "/mobile/:slug", "destination": "/mobile.html" },
    { "source": "/tv/:slug", "destination": "/tv.html" },
    { "source": "/tv", "destination": "/tv.html" },
    { "source": "/led", "destination": "/tv.html" },
    { "source": "/led/:slug", "destination": "/tv.html" },
    { "source": "/checkin/:slug", "destination": "/checkin.html" },
    { "source": "/simulasi", "destination": "/simulasi.html" },
    { "source": "/mexicano", "destination": "/mexicano.html" },
    { "source": "/mexicano/score/:slug/:court", "destination": "/mexicano-score.html" },
    { "source": "/mexicano/tv/:slug", "destination": "/mexicano-tv.html" },
    { "source": "/mexicano/p/:slug", "destination": "/mexicano-player.html" },
    { "source": "/draw", "destination": "/draw.html" },
    { "source": "/tambah-peserta", "destination": "/tambah-peserta.html" },
    { "source": "/daftar/:id", "destination": "/daftar.html" },
    { "source": "/daftar", "destination": "/daftar.html" },
    { "source": "/klaim", "destination": "/klaim.html" },
    { "source": "/roster/:id", "destination": "/roster.html" },
    { "source": "/bayar/:id", "destination": "/bayar.html" },
    { "source": "/rules", "destination": "/rules/index.html" },
    { "source": "/engine", "destination": "/engine/index.html" },
    { "source": "/event/:slug", "destination": "/event.html" },
    { "source": "/:slug", "destination": "/event.html" }
  ]
}
